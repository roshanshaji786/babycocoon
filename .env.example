# PostgreSQL connection string used by the API routes, drizzle-kit and the seed script.
# Local dev default (docker-compose style): postgresql://postgres:postgres@127.0.0.1:5432/app_db
# For production, use a free hosted Postgres such as Neon: https://neon.tech
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
